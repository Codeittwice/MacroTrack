{
  "name": "macrotrack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "nevo": "tsx scripts/build-nevo.ts",
    "eval:ai": "tsx scripts/eval-ai.ts",
    "cap:sync": "npm run build && npx cap sync android",
    "android:emu": "npm run cap:sync && npx cap run android",
    "android:live": "npx cap run android -l --external",
    "android:apk": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "android:open": "npx cap open android",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@tauri-apps/api": "^2.11.1",
    "@zxing/browser": "^0.2.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.460.0",
    "minisearch": "^7.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "recharts": "^2.15.3",
    "zod": "^3.25.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@playwright/test": "^1.53.0",
    "@tailwindcss/vite": "^4.1.8",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0"
  }
}
